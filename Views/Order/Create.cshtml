@model BakeryMongoApp.Models.CreateOrderViewModel

@{
    ViewData["Title"] = "Place bakery order";
}

<h2>Place your order</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">


            @if (TempData["Message"] != null)
            {
                <div class="alert alert-info">@TempData["Message"]</div>
            }

            <div class="form-group mb-3">
                <label class="control-label"> Customer Name</label>
                <input name="name" class="form-control" required />
            </div>
            <div class="form-group mb-3">
                <label class="control-label">Mobile Number</label>
                <input name="mobileNo" pattern="[0-9]{10}" class="form-control" required
                    title="mobile number must be 10 digits" />
            </div>
            <h4>Select order items</h4>
            <table class="table table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>Item Name</th>
                        <th>Price</th>
                        <th style="width: 150px;">Quantity</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.MenuItems != null)
                    {
                        foreach (var item in Model.MenuItems)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>$@item.Price</td>
                                <td>
                                    <input type="hidden" name="menuItemIds" value="@item.Id" />
                                    <input type="number" name="quantities" value="0" min="0" max="100" class="form-control" />
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <div class="form-group mt-4">
                <input type="submit" value="Submit Order" />
                <a asp-controller="Order" asp-action="SearchOrder" class="ms-4">Search order</a>

            </div>


        </form>
    </div>
</div>