@{
    ViewData["Title"] = "Cancel Bakery Order";
}

<h2>Cancel Bakery Order</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Delete">
            @if (ViewBag.Message != null)
            {
                <div class="alert alert-info">@ViewBag.Message</div>
            }

            <div class="form-group mb-3">
                <label class="control-label fw-bold">Customer Mobile Number</label>
                <input name="mobileNo" class="form-control" required />
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Cancel Order" />
                <a asp-controller="Order" asp-action="Create" class="ms-4">Add order</a>
            </div>
        </form>
    </div>
</div>
